{
    "name": "@p2ppsr/cars-node",
    "version": "1.4.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/p2ppsr/cars-node"
    },
    "main": "dist/src/server.js",
    "files": [
        "dist",
        "k8s",
        "README.md",
        "GETTING_STARTED.md",
        "LICENSE.txt"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
        "test": "npm run build && node --test test/*.test.cjs",
        "migrate:shared-db": "tsx src/tools/migrate-shared-db.ts",
        "seed:advertisements": "node dist/src/tools/seed-advertisement-registry.js",
        "revoke:legacy-advertisements": "node dist/src/tools/revoke-legacy-advertisements.js",
        "start:advertisements": "node dist/src/advertisement-controller.js",
        "start:build-controller": "node dist/src/build-controller-server.js",
        "start:namespace-lifecycle": "node dist/src/namespace-lifecycle-server.js",
        "start:dev": "tsx watch src/server.ts",
        "start:prod": "node dist/src/server.js",
        "setup": "node dist/setup.js",
        "prepublishOnly": "npm run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@bsv/auth-express-middleware": "^2.0.4",
        "@bsv/overlay": "2.3.0",
        "@bsv/overlay-discovery-services": "2.2.0",
        "@bsv/overlay-express": "2.6.0",
        "@bsv/payment-express-middleware": "^2.0.1",
        "@bsv/sdk": "2.4.1",
        "@bsv/wallet-toolbox": "2.7.0",
        "@bsv/wallet-toolbox-client": "2.7.0",
        "@sendgrid/mail": "^8.1.4",
        "@types/express": "^4.17.17",
        "axios": "^1.7.9",
        "body-parser": "^1.20.2",
        "chalk": "^5.4.0",
        "connect-timeout": "^1.9.0",
        "cron": "^3.3.1",
        "express": "^4.18.2",
        "express-async-errors": "3.1.1",
        "express-rate-limit": "8.7.0",
        "fs-extra": "^11.2.0",
        "helmet": "8.3.0",
        "inquirer": "^12.2.0",
        "knex": "^3.1.0",
        "mongodb": "^6.12.0",
        "mysql2": "^3.11.5",
        "pino": "^9.5.0",
        "pino-pretty": "^13.0.0",
        "tar-stream": "3.2.1"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^20.4.2",
        "tsx": "^4.19.2",
        "typescript": "^5.2.2"
    }
}
