{
    "name": "@p2ppsr/cars-node",
    "version": "1.3.22",
    "repository": {
        "type": "git",
        "url": "https://github.com/p2ppsr/cars-node"
    },
    "main": "dist/src/server.js",
    "files": [
        "dist",
        "k8s",
        "README.md",
        "GETTING_STARTED.md",
        "LICENSE.txt"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run build && node --test test/*.test.cjs",
        "migrate:shared-db": "tsx src/tools/migrate-shared-db.ts",
        "start:dev": "tsx watch src/server.ts",
        "start:prod": "node dist/src/server.js",
        "setup": "node dist/setup.js",
        "prepublishOnly": "npm run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@bsv/auth-express-middleware": "^2.0.4",
        "@bsv/payment-express-middleware": "^2.0.1",
        "@bsv/sdk": "2.4.0",
        "@bsv/wallet-toolbox": "2.7.0",
        "@bsv/wallet-toolbox-client": "2.7.0",
        "@sendgrid/mail": "^8.1.4",
        "@types/express": "^4.17.17",
        "axios": "^1.7.9",
        "body-parser": "^1.20.2",
        "chalk": "^5.4.0",
        "connect-timeout": "^1.9.0",
        "cron": "^3.3.1",
        "express": "^4.18.2",
        "fs-extra": "^11.2.0",
        "inquirer": "^12.2.0",
        "knex": "^3.1.0",
        "mongodb": "^6.12.0",
        "mysql2": "^3.11.5",
        "pino": "^9.5.0",
        "pino-pretty": "^13.0.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^20.4.2",
        "tsx": "^4.19.2",
        "typescript": "^5.2.2"
    }
}
